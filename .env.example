# Server
PORT=4010
HOST=0.0.0.0
LOG_LEVEL=info

# SQLite file. Created on first start. Keep it on a persistent volume.
DB_PATH=./data/gitbot.db

# Required. Sent by admins as the X-Admin-Secret header.
ADMIN_SECRET=change-me

# Where bots come from. Indexed on POST /admin/reindex.
LIBRARY_REPO=gitbot-hq/Library
LIBRARY_REF=main
# Optional: raises the GitHub API rate limit and allows a private library.
GITHUB_TOKEN=
# Optional: index a local checkout instead of GitHub (dev / tests).
LIBRARY_PATH=
